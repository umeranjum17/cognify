{
  "version": 2,
  "installCommand": "npm --prefix api ci || npm --prefix api install",
  "buildCommand": "echo 'No build needed for Edge Functions'",
  "rewrites": [
    { "source": "/callback", "destination": "/api/oauth/callback" },
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/config/models", "destination": "/api/config/models" },
    { "source": "/api/config/modes", "destination": "/api/config/modes" },
    { "source": "/api/credits/consume", "destination": "/credits/consume" },
    { "source": "/api/credits/balance", "destination": "/credits/balance" },
    { "source": "/api/credits/refund", "destination": "/credits/refund" },
    { "source": "/api/rc/webhook", "destination": "/rc/webhook" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version"
        }
      ]
    }
  ]
}
