# Local Properties Template
# Copy this to android/local.properties and fill in your values
# DO NOT commit this file to git - it contains sensitive information

# Android SDK path (set by Android Studio automatically)
sdk.dir=/Users/YOUR_USERNAME/Library/Android/sdk

# Flutter SDK path
flutter.sdk=/path/to/flutter

# Build configuration
flutter.buildMode=release
flutter.versionName=1.0.7
flutter.versionCode=33

# Release signing configuration
# IMPORTANT: Copy cognify-release-key.jks to your computer first
storeFile=/path/to/cognify-release-key.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=cognify
keyPassword=YOUR_KEY_PASSWORD

# Notes:
# - Replace YOUR_USERNAME with your actual username
# - Replace /path/to/flutter with your Flutter SDK path
# - Replace /path/to/cognify-release-key.jks with actual keystore path
# - Get passwords from CREDENTIALS.txt (keep secure!)



