rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read/write their own user data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to read/write their own credits
    match /users/{userId}/credits/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to read/write their own conversations
    match /users/{userId}/conversations/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to read/write their own messages
    match /users/{userId}/messages/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to read/write their own sessions
    match /users/{userId}/sessions/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow anyone to write feedback (for anonymous users too)
    match /feedback/{document} {
      allow write: if true;
      allow read: if false; // Only admins should read feedback
    }
    
    // Allow authenticated users to read/write analytics (for their own data)
    match /analytics/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write RC events
    match /rc_events/{document} {
      allow read, write: if request.auth != null;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

