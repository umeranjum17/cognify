<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Allow cleartext traffic to localhost and common local IPs for development -->
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">127.0.0.0/8</domain>
        <domain includeSubdomains="true">localhost</domain>
        <!-- Android emulator host access (10.0.2.2) -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <!-- Allow cleartext traffic to the production backend -->
        <domain includeSubdomains="true">cognify-backend.fly.dev</domain>
    </domain-config>
</network-security-config>
